# logger configurations.
log_level=INFO
log_path=./logs/

# summary report configurations.
summary_report_path = ./summary_reports/

# searching results configurations.
searching_results_path = ./searching_results/

# Data Source configurations.
source_filename = amazon_google_reviews.csv
source_folderpath = ./data/original/

# Temporary files configurations.
tempfiles_folderpath = ./data/temp/

# HuggingFace settings.
# 1. Sentimental Model settings.
sentimental_model = distilbert-base-uncased-finetuned-sst-2-english

# 2. view categorizing settings.
categorizier_model = Qwen/Qwen2.5-1.5B-Instruct
labeller_model = facebook/bart-large-mnli
